# TiDB Cloud Connection Configuration
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_user.root
TIDB_PASSWORD=your_password
TIDB_DATABASE=dokani
TIDB_ENABLE_SSL=true

# Or full connection string (alternative):
# DATABASE_URL=mysql://user:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/dokani?ssl={"rejectUnauthorized":true}

# App Port
PORT=3000
